# OpenAI-compatible model provider
PAPERAI_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PAPERAI_MODEL_API_KEY=
PAPERAI_MODEL=qwen-plus
PAPERAI_MODEL_TIMEOUT=180

# Local service
PAPERAI_HOST=127.0.0.1
PAPERAI_PORT=8080
PAPERAI_DATA_DIR=./data
PAPERAI_DATABASE=./data/paperai.db
PAPERAI_MAX_SOURCE_CHARS=120000
PAPERAI_ALLOW_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
PAPERAI_DEBUG=false
